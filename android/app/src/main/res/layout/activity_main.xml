<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Cabecera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/band"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="40dp"
            android:paddingBottom="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="XAU/USD · Señales"
                android:textColor="@color/band_ink"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Lee LIFT.SIGNALS en Telegram y deja la señal fija en tus notificaciones."
                android:textColor="@color/band_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Señal actual -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView style="@style/Eyebrow" android:text="Señal ahora" />
                <TextView
                    android:id="@+id/txtSignalTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/ink"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtSignalBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ink2"
                    android:textSize="14sp" />
                <Button
                    android:id="@+id/btnClose"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Cerrar señal a mano" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnOpenWeb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/gold"
            android:text="Mi registro"
            android:textColor="@color/band" />

        <!-- Permisos -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView style="@style/Eyebrow" android:text="Permisos" />
                <TextView android:id="@+id/txtAccess" style="@style/Line" />
                <Button android:id="@+id/btnAccess" style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Dar acceso a notificaciones" />
                <TextView android:id="@+id/txtNotif" style="@style/Line" />
                <Button android:id="@+id/btnNotifPerm" style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Permitir notificaciones" />
                <TextView android:id="@+id/txtBattery" style="@style/Line" />
                <Button android:id="@+id/btnBattery" style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Quitar restricción de batería" />
                <TextView android:id="@+id/txtLive" style="@style/Line" />
                <Button android:id="@+id/btnLive" style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Activar actualizaciones en directo" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Ajustes -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView style="@style/Eyebrow" android:text="Ajustes" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAlarm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⏰ Modo alarma (para dormir)"
                    android:textColor="@color/ink"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtAlarm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink2"
                    android:textSize="13sp"
                    android:text="Cuando está activado, cada señal, promedio o cierre suena como un despertador hasta que lo pares." />
                <Button android:id="@+id/btnFullScreen" style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Permitir alarma a pantalla completa" />
                <Button android:id="@+id/btnTestAlarm" style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Probar alarma en 10 s" />
                <TextView style="@style/Line" android:text="Nombre del canal en Telegram" />
                <EditText
                    android:id="@+id/inputTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/ink" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchSound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Sonido de aviso (suena con No molestar)"
                    android:textColor="@color/ink" />
                <Button android:id="@+id/btnSave" style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="Guardar" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pruebas -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView style="@style/Eyebrow" android:text="Probar sin esperar al canal" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnTestOpen" style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp" android:text="Señal" />
                    <Button android:id="@+id/btnTestAvg" style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="Promedio" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnTestCloseAvg" style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp" android:text="Cerrar prom." />
                    <Button android:id="@+id/btnTestClose" style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="Cerrar todo" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Historial -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView style="@style/Eyebrow" android:text="Historial" />
                <TextView
                    android:id="@+id/txtHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/ink2"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
