<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===== SEÑAL ===== -->
        <ScrollView
            android:id="@+id/pageSignal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/band"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="40dp"
                    android:paddingBottom="18dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="XAU/USD · Señales"
                        android:textColor="@color/band_ink"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView style="@style/Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView style="@style/Eyebrow" android:text="Señal actual" />
                        <TextView
                            android:id="@+id/txtSignalTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/ink"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtSignalBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/ink2"
                            android:textSize="14sp" />
                        <Button
                            android:id="@+id/btnClose"
                            style="@style/BtnOutlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Cerrar señal a mano" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFloat"
                    style="@style/Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView style="@style/Eyebrow" android:text="Flotante" />
                        <TextView
                            android:id="@+id/txtFloat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/ink"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtFloatInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/ink2"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView style="@style/Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAlarm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="⏰ Modo alarma"
                        android:textColor="@color/ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- ===== REGISTRO (web dentro de la app) ===== -->
        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- ===== HISTORIAL ===== -->
        <ScrollView
            android:id="@+id/pageHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="28dp"
                android:paddingBottom="24dp">
                <com.google.android.material.card.MaterialCardView style="@style/Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView style="@style/Eyebrow" android:text="Historial" />
                        <TextView
                            android:id="@+id/txtHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="monospace"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/ink2"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- ===== AJUSTES ===== -->
        <ScrollView
            android:id="@+id/pageSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="28dp"
                android:paddingBottom="24dp">

                <!-- Permisos -->
                <com.google.android.material.card.MaterialCardView style="@style/Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView style="@style/Eyebrow" android:text="Permisos" />
                        <TextView android:id="@+id/txtAccess" style="@style/Line" />
                        <Button android:id="@+id/btnAccess" style="@style/BtnTonal" android:text="Dar acceso a notificaciones" />
                        <TextView android:id="@+id/txtNotif" style="@style/Line" />
                        <Button android:id="@+id/btnNotifPerm" style="@style/BtnTonal" android:text="Permitir notificaciones" />
                        <TextView android:id="@+id/txtBattery" style="@style/Line" />
                        <Button android:id="@+id/btnBattery" style="@style/BtnTonal" android:text="Quitar restricción de batería" />
                        <TextView android:id="@+id/txtLive" style="@style/Line" />
                        <Button android:id="@+id/btnLive" style="@style/BtnTonal" android:text="Activar actualizaciones en directo" />
                        <TextView android:id="@+id/txtFullScreen" style="@style/Line" />
                        <Button android:id="@+id/btnFullScreen" style="@style/BtnTonal" android:text="Permitir alarma a pantalla completa" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Cuentas -->
                <com.google.android.material.card.MaterialCardView style="@style/Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView style="@style/Eyebrow" android:text="Registro · Google" />
                        <TextView android:id="@+id/txtGoogle" style="@style/Line" />
                        <Button android:id="@+id/btnGoogle" style="@style/BtnTonal" android:text="Iniciar sesión con Google" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView style="@style/Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView style="@style/Eyebrow" android:text="Myfxbook" />
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchMfx"
                            style="@style/Sw"
                            android:text="Mostrar el flotante" />
                        <TextView
                            android:id="@+id/txtMfx"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/ink2"
                            android:textSize="13sp" />
                        <EditText
                            android:id="@+id/inputMfxEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Email"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/ink"
                            android:textColorHint="@color/ink2" />
                        <EditText
                            android:id="@+id/inputMfxPass"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Contraseña"
                            android:inputType="textPassword"
                            android:textColor="@color/ink"
                            android:textColorHint="@color/ink2" />
                        <Button android:id="@+id/btnMfx" style="@style/BtnTonal" android:text="Conectar" />
                        <TextView style="@style/Line" android:text="Cuenta" />
                        <Spinner
                            android:id="@+id/spinnerMfx"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Configuración -->
                <com.google.android.material.card.MaterialCardView style="@style/Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView style="@style/Eyebrow" android:text="Configuración" />
                        <TextView style="@style/Line" android:text="Canal de Telegram" />
                        <EditText
                            android:id="@+id/inputTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="@color/ink" />
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchSound"
                            style="@style/Sw"
                            android:text="Sonido de aviso" />
                        <Button android:id="@+id/btnSave" style="@style/BtnTonal"
                            android:layout_marginTop="6dp" android:text="Guardar" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Pruebas -->
                <com.google.android.material.card.MaterialCardView style="@style/Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView style="@style/Eyebrow" android:text="Pruebas" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <Button android:id="@+id/btnTestOpen" style="@style/BtnOutlined"
                                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp" android:text="Señal" />
                            <Button android:id="@+id/btnTestAvg" style="@style/BtnOutlined"
                                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                                android:text="Promedio" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <Button android:id="@+id/btnTestCloseAvg" style="@style/BtnOutlined"
                                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp" android:text="Cerrar prom." />
                            <Button android:id="@+id/btnTestClose" style="@style/BtnOutlined"
                                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                                android:text="Cerrar todo" />
                        </LinearLayout>
                        <Button android:id="@+id/btnTestAlarm" style="@style/BtnOutlined"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Probar alarma en 10 s" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:itemIconTint="@color/nav_item"
        app:itemTextColor="@color/nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
