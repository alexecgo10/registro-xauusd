<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ===== SEÑAL ===== -->
        <ScrollView
            android:id="@+id/pageSignal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- Precio del oro -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/band"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="40dp"
                    android:paddingBottom="18dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="XAU/USD"
                        android:textColor="@color/band_ink"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txtPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="—"
                            android:textColor="@color/band_ink"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtPriceInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="@color/band_dim"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Señal actual (se despliega con sus promedios) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSignal"
                    style="@style/Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView style="@style/Eyebrow" android:layout_width="0dp" android:layout_weight="1" android:text="Señal actual" />
                            <TextView
                                android:id="@+id/txtSignalChevron"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/ink2"
                                android:textSize="13sp" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/txtSignalTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/ink"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtSignalBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/ink2"
                            android:textSize="14sp" />
                        <LinearLayout
                            android:id="@+id/boxSignalAvgs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical"
                            android:visibility="gone" />
                        <Button
                            android:id="@+id/btnClose"
                            style="@style/BtnOutlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Cerrar señal a mano" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Operaciones abiertas -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTrades"
                    style="@style/Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView style="@style/Eyebrow" android:layout_width="0dp" android:layout_weight="1" android:text="Operaciones abiertas" />
                            <TextView
                                android:id="@+id/txtStale"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚠️"
                                android:textSize="15sp"
                                android:visibility="gone" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/boxTrades"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Promedios (órdenes límite) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOrders"
                    style="@style/Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView style="@style/Eyebrow" android:text="Promedios" />
                        <LinearLayout
                            android:id="@+id/boxOrders"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Alarmas -->
                <com.google.android.material.card.MaterialCardView style="@style/Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp">
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchAlarm"
                            style="@style/Sw"
                            android:text="⏰ Modo alarma"
                            android:textStyle="bold" />
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchSched"
                            style="@style/Sw"
                            android:text="🌙 Alarma con horario"
                            android:textStyle="bold" />
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchDnd"
                            style="@style/Sw"
                            android:text="🔕 No molestar"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- ===== REGISTRO (web dentro de la app) ===== -->
        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- ===== HISTORIAL ===== -->
        <ScrollView
            android:id="@+id/pageHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="28dp"
                android:paddingBottom="24dp">
                <com.google.android.material.card.MaterialCardView style="@style/Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView style="@style/Eyebrow" android:text="Historial" />
                        <TextView
                            android:id="@+id/txtHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="monospace"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/ink2"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- ===== AJUSTES ===== -->
        <ScrollView
            android:id="@+id/pageSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="28dp"
                android:paddingBottom="24dp">

                <!-- Permisos -->
                <com.google.android.material.card.MaterialCardView style="@style/Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView style="@style/Eyebrow" android:text="Permisos" />
                        <TextView android:id="@+id/txtAccess" style="@style/Line" />
                        <Button android:id="@+id/btnAccess" style="@style/BtnTonal" android:text="Dar acceso a notificaciones" />
                        <TextView android:id="@+id/txtNotif" style="@style/Line" />
                        <Button android:id="@+id/btnNotifPerm" style="@style/BtnTonal" android:text="Permitir notificaciones" />
                        <TextView android:id="@+id/txtBattery" style="@style/Line" />
                        <Button android:id="@+id/btnBattery" style="@style/BtnTonal" android:text="Quitar restricción de batería" />
                        <TextView android:id="@+id/txtLive" style="@style/Line" />
                        <Button android:id="@+id/btnLive" style="@style/BtnTonal" android:text="Activar actualizaciones en directo" />
                        <TextView android:id="@+id/txtFullScreen" style="@style/Line" />
                        <Button android:id="@+id/btnFullScreen" style="@style/BtnTonal" android:text="Permitir alarma a pantalla completa" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Cuentas -->
                <com.google.android.material.card.MaterialCardView style="@style/Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView style="@style/Eyebrow" android:text="Registro · Google" />
                        <TextView android:id="@+id/txtGoogle" style="@style/Line" />
                        <Button android:id="@+id/btnGoogle" style="@style/BtnTonal" android:text="Iniciar sesión con Google" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView style="@style/Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView style="@style/Eyebrow" android:text="Myfxbook" />
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchMfx"
                            style="@style/Sw"
                            android:text="Mostrar el flotante" />
                        <TextView
                            android:id="@+id/txtMfx"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/ink2"
                            android:textSize="13sp" />
                        <EditText
                            android:id="@+id/inputMfxEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Email"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/ink"
                            android:textColorHint="@color/ink2" />
                        <EditText
                            android:id="@+id/inputMfxPass"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Contraseña"
                            android:inputType="textPassword"
                            android:textColor="@color/ink"
                            android:textColorHint="@color/ink2" />
                        <Button android:id="@+id/btnMfx" style="@style/BtnTonal" android:text="Conectar" />
                        <TextView style="@style/Line" android:text="Cuenta" />
                        <Spinner
                            android:id="@+id/spinnerMfx"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Configuración -->
                <com.google.android.material.card.MaterialCardView style="@style/Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView style="@style/Eyebrow" android:text="Configuración" />
                        <TextView style="@style/Line" android:text="Canal de Telegram" />
                        <EditText
                            android:id="@+id/inputTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="@color/ink" />
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchSound"
                            style="@style/Sw"
                            android:text="Sonido de aviso" />
                        <TextView style="@style/Line" android:text="Precio en segundo plano, cada" />
                        <RadioGroup
                            android:id="@+id/radioInterval"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <RadioButton android:id="@+id/int5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="16dp" android:text="5 s" android:textColor="@color/ink" />
                            <RadioButton android:id="@+id/int10" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="16dp" android:text="10 s" android:textColor="@color/ink" />
                            <RadioButton android:id="@+id/int20" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20 s" android:textColor="@color/ink" />
                        </RadioGroup>
                        <Button android:id="@+id/btnSave" style="@style/BtnTonal"
                            android:layout_marginTop="6dp" android:text="Guardar" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Alarmas -->
                <com.google.android.material.card.MaterialCardView style="@style/Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView style="@style/Eyebrow" android:text="Alarmas" />
                        <TextView style="@style/Line" android:text="Horario de la alarma" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <EditText
                                android:id="@+id/inputSchedFrom"
                                android:layout_width="0dp" android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:hint="00:00"
                                android:inputType="time"
                                android:textColor="@color/ink"
                                android:textColorHint="@color/ink2" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:paddingHorizontal="12dp" android:text="a" android:textColor="@color/ink2" />
                            <EditText
                                android:id="@+id/inputSchedTo"
                                android:layout_width="0dp" android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:hint="08:00"
                                android:inputType="time"
                                android:textColor="@color/ink"
                                android:textColorHint="@color/ink2" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchFloatAlarm"
                            style="@style/Sw"
                            android:layout_marginTop="10dp"
                            android:text="Alarma si el flotante baja de" />
                        <EditText
                            android:id="@+id/inputFloatLimit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="500 $"
                            android:inputType="numberDecimal"
                            android:textColor="@color/ink"
                            android:textColorHint="@color/ink2" />
                        <Button android:id="@+id/btnSaveAlarms" style="@style/BtnTonal" android:text="Guardar" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Pruebas -->
                <com.google.android.material.card.MaterialCardView style="@style/Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView style="@style/Eyebrow" android:text="Pruebas" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <Button android:id="@+id/btnTestOpen" style="@style/BtnOutlined"
                                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp" android:text="Señal" />
                            <Button android:id="@+id/btnTestAvg" style="@style/BtnOutlined"
                                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                                android:text="Promedio" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <Button android:id="@+id/btnTestCloseAvg" style="@style/BtnOutlined"
                                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp" android:text="Cerrar prom." />
                            <Button android:id="@+id/btnTestClose" style="@style/BtnOutlined"
                                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                                android:text="Cerrar todo" />
                        </LinearLayout>
                        <Button android:id="@+id/btnTestAlarm" style="@style/BtnOutlined"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Probar alarma en 10 s" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:itemIconTint="@color/nav_item"
        app:itemTextColor="@color/nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
