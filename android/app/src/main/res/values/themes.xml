<resources>
    <style name="Theme.RegistroXAU" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/band</item>
        <item name="colorOnPrimary">@color/band_ink</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="android:statusBarColor">@color/band</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.RegistroXAU.Dialog</item>
    </style>

    <!-- Ventanas emergentes: textos y botones con buen contraste también en modo oscuro. -->
    <style name="ThemeOverlay.RegistroXAU.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink2</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink2</item>
        <item name="android:textColorHint">@color/ink2</item>
        <item name="colorPrimary">@color/gold</item>
        <item name="colorAccent">@color/gold</item>
        <item name="materialAlertDialogTitleTextStyle">@style/DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/DialogBody</item>
    </style>
    <style name="DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="DialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/ink2</item>
    </style>

    <style name="Card" parent="Widget.Material3.CardView.Elevated">
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">12dp</item>
    </style>

    <style name="Eyebrow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="Line">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="BtnOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/ink2</item>
        <item name="strokeColor">@color/ink2</item>
    </style>

    <style name="BtnTonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Sw">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
